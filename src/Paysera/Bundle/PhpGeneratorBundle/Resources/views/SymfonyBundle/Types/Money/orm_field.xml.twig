<field name="{{ property.name|to_variable_name }}Amount" column="{{ property.name|to_snake_case }}_amount" nullable="{{ property.allowsNullValue ? 'true' : 'false' }}" type="decimal" precision="16" scale="6"/>
        <field name="{{ property.name|to_variable_name }}Currency" column="{{ property.name|to_snake_case }}_currency" nullable="{{ property.allowsNullValue ? 'true' : 'false' }}" type="string"/>
