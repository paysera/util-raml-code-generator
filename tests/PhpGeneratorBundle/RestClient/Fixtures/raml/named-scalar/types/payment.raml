#%RAML 1.0 DataType
type: object
displayName: Payment object
properties:
  id:
    type: string
    required: true
    description: Object id
  currency:
    type: Currency
    required: true
    description: Named scalar type used as a property
  allowed_currencies:
    type: array
    items:
      type: Currency
    required: false
    description: Named scalar type used as an array item type
  account_number:
    type: AccountNumber
    required: true
    description: Named scalar type without allowed values
  scan_result:
    type: ScanResult
    required: false
    description: Named scalar type claimed by ResultTypeBuilder
  filter_mode:
    type: FilterMode
    required: false
    description: Named scalar type claimed by FilterTypeDefinitionBuilder
  metadata:
    type: PaymentMetadata
    required: false
    description: Domain type whose name contains "metadata"
  search_metadata:
    type: SearchResultMetadata
    required: false
    description: Domain type whose name contains "Result" and ends in "Metadata"
