<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="vendor_named_scalar_api.normalizer.currency_result"
                 class="Paysera\Component\Serializer\Normalizer\ResultNormalizer"
                 parent="paysera_rest.normalizer.result">
            <argument>currencies</argument>
            <argument type="service" id="paysera_rest.normalizer.plain"/>
            
        </service>
        <service id="vendor_named_scalar_api.normalizer.payment"
                 class="Vendor\Test\NamedScalarApiBundle\Normalizer\PaymentNormalizer">
            <argument type="service" id="vendor_named_scalar_api.normalizer.payment_metadata"/>
            <argument type="service" id="vendor_named_scalar_api.normalizer.search_result_metadata"/>
        </service>
        <service id="vendor_named_scalar_api.normalizer.payment_metadata"
                 class="Vendor\Test\NamedScalarApiBundle\Normalizer\PaymentMetadataNormalizer">
        </service>
        <service id="vendor_named_scalar_api.normalizer.search_result_metadata"
                 class="Vendor\Test\NamedScalarApiBundle\Normalizer\SearchResultMetadataNormalizer">
        </service>
        
        
    </services>
</container>
