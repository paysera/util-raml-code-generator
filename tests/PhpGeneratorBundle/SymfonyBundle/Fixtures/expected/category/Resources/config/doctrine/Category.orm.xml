<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity repository-class="Vendor\Test\CategoryApiBundle\Repository\CategoryRepository"
            name="Vendor\Test\CategoryApiBundle\Entity\Category" table="category_api_categories">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="parentId" column="parent_id" nullable="true" type="string"/>
        <!--TODO: generated_code non-scalar property <field name="titles" column="titles" nullable="false" type="array"/>-->
        <field name="status" column="status" nullable="true" type="string"/>
        <field name="enabled" column="enabled" nullable="true" type="boolean"/>
        <field name="updatedAt" column="updated_at" nullable="true" type="datetime"/>
        <!--TODO: generated_code <field name="keyword" column="keyword" nullable="true" type="reference"/>-->
        <field name="archived" column="archived" nullable="true" type="boolean"/>
        <field name="score" column="score" nullable="true" type="integer"/>
        <field name="nickname" column="nickname" nullable="true" type="string"/>
        <!--TODO: generated_code non-scalar property <field name="tags" column="tags" nullable="false" type="array"/>-->
        <field name="state" column="state" nullable="true" type="string"/>
        <field name="payload" column="payload" nullable="true" type="object"/>
        <field name="priceAmount" column="price_amount" nullable="true" type="decimal" precision="16" scale="6"/>
        <field name="priceCurrency" column="price_currency" nullable="true" type="string"/>
        <field name="closedAt" column="closed_at" nullable="true" type="datetime"/>
        
    </entity>
</doctrine-mapping>
